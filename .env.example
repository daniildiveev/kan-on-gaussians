# Copy to .env. Pass _env_file=".env" to ModelSettings and TrainingSettings.
MGS_KAN_FEATURES=12
MGS_KAN_MLP_WIDTH=24
# Optional reproducible initial weights, independent of training batch order.
# MGS_KAN_INIT_SEED=17

# Gaussian kernels and initialization
MGS_KAN_SINGLE_KERNELS=4
MGS_KAN_PAIR_KERNELS=2
MGS_KAN_SINGLE_CENTER_RANGE='[-1.5, 1.5]'
MGS_KAN_SINGLE_AMPLITUDE_SD=0.09
MGS_KAN_PAIR_AMPLITUDE_SD=0.035
MGS_KAN_PAIR_CENTER_SD=0.55
MGS_KAN_PAIR_FACTOR_SD=0.08

# Regression training
MGS_KAN_TRAIN_SEED=42
MGS_KAN_TRAIN_EPOCHS=50
MGS_KAN_TRAIN_BATCH_SIZE=64
MGS_KAN_TRAIN_LEARNING_RATE=0.001
MGS_KAN_TRAIN_DEVICE=cpu

# Optional shared tracking. Set the URI to your existing MLflow server.
# MLFLOW_TRACKING_URI=https://mlflow.example.org
MLFLOW_EXPERIMENT_NAME=mgs-kan
MLFLOW_CHECKPOINT_FILE=best.pt
